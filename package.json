{
  "name": "@mridang/nestjs-platform-cloudflare",
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "tsc",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "keywords": [
    "nestjs",
    "cloudflare",
    "workers",
    "adapter",
    "fetch",
    "serverless"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "description": "Cloudflare Workers HTTP adapter for NestJS — run NestJS on Workers with no Express, no node:http, and no port.",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/nestjs-platform-cloudflare.git"
  },
  "homepage": "https://github.com/mridang/nestjs-platform-cloudflare",
  "bugs": "https://github.com/mridang/nestjs-platform-cloudflare/issues",
  "peerDependencies": {
    "@cloudflare/workers-types": "^5",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.0.3",
    "@mridang/eslint-defaults": "^2.1.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.14.0",
    "helmet": "^8.0.0",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "semantic-release": "^25.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3",
    "urlpattern-polyfill": "^10.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@eslint/core": "1.2.1"
  }
}
